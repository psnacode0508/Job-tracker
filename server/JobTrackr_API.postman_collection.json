              "raw": "{\n  \"text\": \"<img src=x onerror=alert(1)>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{appAId}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{appAId}}",
                "notes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Assert note stored safely as raw text without execution\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    var notes = jsonData.data.notes;",
                  "    var lastNote = notes[notes.length - 1];",
                  "    pm.expect(lastNote.text).to.eql(\"<img src=x onerror=alert(1)>\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate limit test: 6 consecutive failed POST /auth/login attempts -> assert 6th returns 429",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fire 5 rapid failed attempts before the 6th to trigger the 5-request rate limit window",
                  "const loginUrl = pm.collectionVariables.get(\"baseUrl\") + \"/auth/login\";",
                  "const payload = {",
                  "    url: loginUrl,",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ email: \"nonexistent@example.com\", password: \"wrongpassword\" })",
                  "    }",
                  "};",
                  "",
                  "for (let i = 1; i <= 5; i++) {",
                  "    pm.sendRequest(payload, function (err, res) {});",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 429 Too Many Requests\", function () {",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "pm.test(\"Assert rate limit error message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.message).to.eql(\"Too many login attempts, please try again after 15 minutes\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
